# Configuración pública del navegador. Copiar a .env.local si es necesaria.
# Dejar vacía hasta que el equipo acuerde la dirección de su backend.
VITE_API_URL=http://127.0.0.1:8000
# VITE_API_BASE_URL se admite como alternativa para compatibilidad.
# memory: no persiste JWT. session: restaura desde sessionStorage con /auth/me.
VITE_AUTH_STORAGE=memory
# Vista previa solo en desarrollo; no autentica ni otorga permisos del backend.
VITE_ENABLE_DEMO=false

# Origen de datos: recursos (JSON local), backend o proveedores (NASA/Open-Meteo).
# En desarrollo el valor predeterminado es recursos; en producción, backend.
VITE_DATA_SOURCE=recursos

# Todo valor VITE_* queda visible en el frontend compilado.
# Las contraseñas, tokens privados y claves de servicio pertenecen al backend.
